---
/*
  Mascote Nukki: imagem provisória (gerada em bitmap, com contorno branco em volta).
  TODO [PLACEHOLDER]: trocar pelo SVG final em camadas (corpo, cabeca, folha, braco,
  olho-esq, olho-dir). A animação em nukki.ts já anima o que existir de data-part.

  Duas camadas alinhadas no mesmo recorte (679x716):
  - o círculo azul é desenhado aqui (mesma posição do círculo da imagem);
  - nukki-figura.png é só o Nukki + contorno. O clipPath mostra a figura dentro do
    círculo e acima do centro dele, então quando ela sobe parece sair do buraco.

  Joinha + piscadela em sprite sheet (futuro): ver o slot [data-nukki-sprite].
*/
import { getImage } from 'astro:assets';
import figura from '../../assets/nukki-figura.png';

const W = 679;
const H = 716;
// Círculo da imagem original, medido no recorte.
const CIRCLE = { cx: 336.1, cy: 379.8, r: 335.9 };

const img = await getImage({ src: figura, width: W, format: 'webp', quality: 85 });

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['nukki', className]} data-nukki>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="nukki-title">
    <title id="nukki-title">Nukki, o mascote tanuki da Nukki Tech, saindo de um círculo azul e acenando</title>
    <defs>
      <clipPath id="nukki-clip">
        <circle cx={CIRCLE.cx} cy={CIRCLE.cy} r={CIRCLE.r}></circle>
        <rect x="0" y="0" width={W} height={CIRCLE.cy}></rect>
      </clipPath>
    </defs>

    <circle class="nukki__circle" data-nukki-circle cx={CIRCLE.cx} cy={CIRCLE.cy} r={CIRCLE.r}></circle>

    <g clip-path="url(#nukki-clip)">
      <g class="nukki__figure" data-nukki-figure>
        <g data-part="corpo">
          <image href={img.src} width={W} height={H}></image>
        </g>
      </g>
    </g>
  </svg>

  <!-- Futuro: sprite sheet do joinha + piscadela (PNG 2x, 8 a 12 frames). -->
  <div class="nukki__sprite" data-nukki-sprite hidden></div>
</div>

<style>
  .nukki {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 679 / 716;
  }

  .nukki svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Mesmo azul do círculo da imagem, para a figura encaixar sem emenda. */
  .nukki__circle {
    fill: #142543;
  }

  /* Escondido até o GSAP posicionar o Nukki lá embaixo, para não piscar. */
  :global(.motion) .nukki__figure,
  :global(.motion) .nukki__circle {
    visibility: hidden;
  }
</style>
