---
// TODO [PLACEHOLDER]: foto do Gustavo. Colocar em src/assets e usar <Picture>
// do astro:assets (formats={['avif', 'webp']}, widths responsivos) no lugar do bloco .about__photo.
---

<section class="section" id="sobre" aria-labelledby="about-title">
  <div class="container about">
    <figure class="about__figure" data-reveal>
      <div class="about__frame">
        <div class="about__photo" role="img" aria-label="Foto de Gustavo Moreira (provisória)">
          <span aria-hidden="true">GM</span>
        </div>

        <!--
          Desenhos do Gustavo, sem fundo, metade sobre os cantos da foto (~20% da largura dela).
          TODO [PLACEHOLDER]: trocar cada .doodle__placeholder por uma <img> do desenho
          (PNG ou SVG com fundo transparente, alt=""), mantendo as classes .doodle--float e .doodle--tilt.
        -->
        <div class="doodle doodle--float" aria-hidden="true">
          <span class="doodle__placeholder">1</span>
        </div>
        <div class="doodle doodle--tilt" aria-hidden="true">
          <span class="doodle__placeholder">2</span>
        </div>
      </div>
      <figcaption class="about__caption">Gustavo Moreira · Fundador</figcaption>
    </figure>

    <div>
      <div class="section-head">
        <h2 id="about-title" class="section-title" data-reveal>Sobre</h2>
      </div>
      <!-- TODO [PLACEHOLDER: revisar com o Gustavo] Carta de apresentação, em primeira pessoa. -->
      <div class="letter" data-reveal>
        <p class="letter__hello">Olá, eu sou o Gustavo.</p>
        <p>
          Desde 2022 desenvolvo automações e sistemas para empresas. Criei a Nukki para resolver de perto o que trava o
          dia a dia de escritórios, comércios e empresas de serviço: a planilha que ninguém aguenta mais, o relatório
          que toma uma tarde, o controle espalhado pelo WhatsApp.
        </p>
        <p>
          Aqui você não fala com atendente nem com vendedor. Fala comigo, que entendo o problema, monto a solução e
          acompanho cada entrega. E se eu achar que tecnologia não é o caminho, eu digo.
        </p>
        <p class="letter__sign">
          <span class="letter__name">Gustavo Moreira</span>
          <span class="letter__role">Fundador da Nukki Tech</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(48px, 8vw, 96px);
    align-items: center;
  }

  @media (min-width: 820px) {
    .about {
      grid-template-columns: minmax(240px, 0.8fr) 1.2fr;
    }
  }

  .about__figure {
    justify-self: center;
    margin: 0;
    /* sobra espaço dos lados para os desenhos que passam das bordas da foto */
    width: min(calc(100% - 80px), 340px);
  }

  .about__frame {
    position: relative;
  }

  /* Desenhos: centro de cada um no canto da foto (metade dentro, metade fora). */
  .doodle {
    position: absolute;
    z-index: 1;
    width: 20%;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .doodle :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Canto superior direito: sobe e desce de leve. */
  .doodle--float {
    top: 0;
    right: 0;
    translate: 50% -50%;
    animation: doodle-float 3.2s ease-in-out infinite;
  }

  /* Canto inferior esquerdo: gira alguns graus no próprio eixo e volta. */
  .doodle--tilt {
    bottom: 0;
    left: 0;
    translate: -50% 50%;
    animation: doodle-tilt 2.8s ease-in-out infinite;
  }

  @keyframes doodle-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes doodle-tilt {
    0%,
    100% {
      transform: rotate(-8deg);
    }
    50% {
      transform: rotate(8deg);
    }
  }

  /* Marcador provisório até os desenhos chegarem. */
  .doodle__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px dashed var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    border: var(--toon-border) solid var(--color-ink);
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    background:
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--color-surface);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 3rem;
    color: var(--color-line-strong);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Linha de "scanner" que passa pela foto no hover. */
  .about__photo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--color-accent-soft) 85%, var(--color-accent) 100%);
    transform: translateY(-110%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .about__figure:hover .about__photo {
      border-color: var(--color-accent);
      box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-accent);
    }

    .about__figure:hover .about__photo::after {
      animation: scan 1.4s var(--motion-ease);
    }
  }

  @keyframes scan {
    to {
      transform: translateY(380%);
    }
  }

  .about__caption {
    /* metade do desenho de baixo (10% da largura) + respiro, para não ficar embaixo dele */
    margin-top: calc(10% + 14px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* Carta de apresentação. */
  .letter {
    display: grid;
    gap: 16px;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    line-height: 1.65;
    color: var(--color-muted);
  }

  .letter__hello {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  .letter__sign {
    display: grid;
    gap: 2px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-line-strong);
  }

  .letter__name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .letter__role {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .doodle {
      animation: none;
    }

    .about__figure:hover .about__photo::after {
      animation: none;
    }
  }
</style>
