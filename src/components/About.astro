---
// TODO [PLACEHOLDER]: foto do Gustavo. Colocar em src/assets e usar <Picture>
// do astro:assets (formats={['avif', 'webp']}, widths responsivos) no lugar do bloco .about__photo.
---

<section class="section" id="sobre" aria-labelledby="about-title">
  <div class="container about">
    <figure class="about__figure" data-reveal>
      <div class="about__frame">
        <div class="about__photo" role="img" aria-label="Foto de Gustavo Moreira (provisória)">
          <span aria-hidden="true">GM</span>
        </div>

        <!--
          Desenhos do Gustavo, sem fundo, metade sobre os cantos da foto (~20% da largura dela).
          TODO [PLACEHOLDER]: trocar cada .doodle__placeholder por uma <img> do desenho
          (PNG ou SVG com fundo transparente, alt=""), mantendo as classes .doodle--float e .doodle--tilt.
        -->
        <div class="doodle doodle--float" aria-hidden="true">
          <span class="doodle__placeholder">1</span>
        </div>
        <div class="doodle doodle--tilt" aria-hidden="true">
          <span class="doodle__placeholder">2</span>
        </div>
      </div>
      <figcaption class="about__caption">Gustavo Moreira · Fundador</figcaption>
    </figure>

    <div>
      <div class="section-head">
        <h2 id="about-title" class="section-title" data-reveal>Quem faz</h2>
      </div>
      <!-- TODO [PLACEHOLDER: revisar com o Gustavo] -->
      <p class="about__body" data-reveal>
        A Nukki é tocada por mim, do diagnóstico à entrega. Você fala direto com quem faz.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(48px, 8vw, 96px);
    align-items: center;
  }

  @media (min-width: 820px) {
    .about {
      grid-template-columns: minmax(240px, 0.8fr) 1.2fr;
    }
  }

  .about__figure {
    justify-self: center;
    margin: 0;
    /* sobra espaço dos lados para os desenhos que passam das bordas da foto */
    width: min(calc(100% - 80px), 340px);
  }

  .about__frame {
    position: relative;
  }

  /* Desenhos: centro de cada um no canto da foto (metade dentro, metade fora). */
  .doodle {
    position: absolute;
    z-index: 1;
    width: 20%;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .doodle :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Canto superior direito: sobe e desce de leve. */
  .doodle--float {
    top: 0;
    right: 0;
    translate: 50% -50%;
    animation: doodle-float 3.2s ease-in-out infinite;
  }

  /* Canto inferior esquerdo: gira alguns graus no próprio eixo e volta. */
  .doodle--tilt {
    bottom: 0;
    left: 0;
    translate: -50% 50%;
    animation: doodle-tilt 2.8s ease-in-out infinite;
  }

  @keyframes doodle-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes doodle-tilt {
    0%,
    100% {
      transform: rotate(-8deg);
    }
    50% {
      transform: rotate(8deg);
    }
  }

  /* Marcador provisório até os desenhos chegarem. */
  .doodle__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1.5px dashed var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    border: var(--toon-border) solid var(--color-ink);
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    background:
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--color-surface);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 3rem;
    color: var(--color-line-strong);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Linha de "scanner" que passa pela foto no hover. */
  .about__photo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--color-accent-soft) 85%, var(--color-accent) 100%);
    transform: translateY(-110%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .about__figure:hover .about__photo {
      border-color: var(--color-accent);
      box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-accent);
    }

    .about__figure:hover .about__photo::after {
      animation: scan 1.4s var(--motion-ease);
    }
  }

  @keyframes scan {
    to {
      transform: translateY(380%);
    }
  }

  .about__caption {
    /* metade do desenho de baixo (10% da largura) + respiro, para não ficar embaixo dele */
    margin-top: calc(10% + 14px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .about__body {
    font-size: clamp(1.375rem, 3vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .doodle {
      animation: none;
    }

    .about__figure:hover .about__photo::after {
      animation: none;
    }
  }
</style>
