---
// Botão pequeno e verde do topo: só o ícone (balão com telefone), mesmo estilo "cartoon" do botão de tema.
import { WHATSAPP_URL } from '../config/site';
---

<a class="wa-icon" href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Chamar no WhatsApp (abre em nova aba)">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="wa-icon__bubble" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"></path>
    <path
      class="wa-icon__phone"
      d="M9.4 7.4c.3-.1.6 0 .8.3l.9 1.6c.2.3.1.7-.1.9l-.6.6c.5 1 1.3 1.8 2.3 2.3l.6-.6c.3-.2.6-.3.9-.1l1.6.9c.3.2.4.5.3.8-.3 1-1.2 1.6-2.2 1.4-2.6-.5-4.7-2.6-5.2-5.2-.2-1 .4-1.9 1.4-2.2Z"
    ></path>
  </svg>
</a>

<style>
  .wa-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: var(--toon-border) solid var(--color-ink);
    border-radius: var(--radius-sm);
    /* Verde do WhatsApp; o ícone fica escuro para ter contraste. */
    background: #25d366;
    color: #06371c;
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    transition:
      translate 0.16s var(--motion-ease),
      box-shadow 0.16s var(--motion-ease),
      background-color 0.2s ease;
  }

  .wa-icon:hover {
    translate: 2px 2px;
    box-shadow: 1px 1px 0 0 var(--color-ink);
    background: #3ee07c;
  }

  .wa-icon:active {
    translate: var(--toon-depth) var(--toon-depth);
    box-shadow: none;
  }

  svg {
    width: 22px;
    height: 22px;
  }

  .wa-icon__bubble {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .wa-icon__phone {
    fill: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-icon {
      transition: none;
    }
  }
</style>
