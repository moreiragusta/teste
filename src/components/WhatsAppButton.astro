---
import Button from './Button.astro';
import { WHATSAPP_URL } from '../config/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<Button href={WHATSAPP_URL} size={size} target="_blank" rel="noopener">
  <span>Chamar no WhatsApp</span>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="visually-hidden">(abre em nova aba)</span>
</Button>
