---
// TODO [PLACEHOLDER]: imagem provisória do Nukki; trocar pelo SVG final do logo.
import { Image } from 'astro:assets';
import nukki from '../assets/nukki.png';
---

<span class="logo">
  <Image class="logo__mark" src={nukki} alt="" width={36} densities={[1, 2, 3]} format="webp" loading="eager" />
  <span class="logo__text">Nukki<span class="logo__tech">Tech</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo__mark {
    width: 36px;
    height: auto;
    margin-block: -4px;
  }

  .logo__tech {
    margin-left: 0.3em;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875em;
    color: var(--color-muted);
  }
</style>
