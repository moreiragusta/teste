// TODO [PLACEHOLDER]: o Nukki desenhado pelo Gustavo deve virar o símbolo da marca.
// Trocar o .logo__mark pelo SVG final quando existir.
---

<span class="logo">
  <span class="logo__mark" aria-hidden="true">N</span>
  <span class="logo__text">Nukki<span class="logo__tech">Tech</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-brand);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    box-shadow: 0 0 0 1px var(--color-line-strong);
  }

  .logo__tech {
    margin-left: 0.3em;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875em;
    color: var(--color-muted);
  }
</style>
