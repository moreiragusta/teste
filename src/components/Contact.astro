---
import WhatsAppButton from './WhatsAppButton.astro';
import { EMAIL, SOCIALS } from '../config/site';

// Ícones em traço (mesmo estilo dos outros ícones do site). E-mail sempre aparece; redes vêm de SOCIALS.
const ICONS: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="3.5"/><circle cx="8" cy="8" r="1.1" fill="currentColor" stroke="none"/><path d="M8 11v6M12 17v-6M12 13.6c0-1.6 1.1-2.6 2.5-2.6S17 12 17 13.6V17"/>',
};

const links = [
  { label: `E-mail: ${EMAIL}`, href: `mailto:${EMAIL}`, icon: 'email', external: false },
  ...SOCIALS.map((s) => ({ label: `${s.name} (abre em nova aba)`, href: s.url, icon: s.icon, external: true })),
];
---

<section class="section contact-section" id="contato" aria-labelledby="contact-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="contact__glow" aria-hidden="true"></div>

  <div class="container contact">
    <h2 id="contact-title" class="section-title" data-reveal>Contato</h2>
    <p class="contact__lead" data-reveal>Conte para nós o que está dando trabalho.</p>
    <div data-reveal>
      <WhatsAppButton size="lg" />
    </div>

    <!-- TODO [PLACEHOLDER]: e-mail e redes ficam em src/config/site.ts -->
    <ul class="contact__icons" role="list" data-reveal>
      {
        links.map((link) => (
          <li>
            <a
              class="contact__icon"
              href={link.href}
              aria-label={link.label}
              title={link.label}
              {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={ICONS[link.icon]} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact-section {
    isolation: isolate;
    overflow-x: clip;
  }

  .contact__glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 35%;
    width: min(800px, 120vw);
    aspect-ratio: 2;
    translate: -50% 0;
    background: radial-gradient(closest-side, var(--color-glow), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  .contact {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 28px;
  }

  /* Frase principal do contato (o título da seção agora é "Contato", igual ao menu). */
  .contact__lead {
    max-width: 18ch;
    margin: -8px 0 12px;
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* E-mail e redes: ícones soltos (sem caixa). No hover/foco o ícone cresce e fica violeta. */
  .contact__icons {
    display: flex;
    gap: 12px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__icon {
    /* área de toque confortável, mas invisível */
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    transition: color 0.25s ease;
  }

  .contact__icon svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .contact__icon:hover,
  .contact__icon:focus-visible {
    color: var(--color-accent);
  }

  .contact__icon:hover svg,
  .contact__icon:focus-visible svg {
    transform: scale(1.35);
  }

  .contact__icon:active svg {
    transform: scale(1.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__icon,
    .contact__icon svg {
      transition: none;
    }
  }
</style>
