---
/*
  Print provisório de um trabalho: um esqueleto de tela desenhado em CSS, sem dados.
  TODO [PLACEHOLDER]: trocar por <Picture> do astro:assets com o print real
  (sempre com dados fictícios), formats={['avif', 'webp']} e widths responsivos.
*/
interface Props {
  variant?: 'dashboard' | 'table' | 'phone';
  label: string;
}
const { variant = 'dashboard', label } = Astro.props;
---

<div class:list={['print', `print--${variant}`]} role="img" aria-label={`${label} (imagem provisória)`}>
  {
    variant === 'phone' ? (
      <div class="print__phone">
        <span class="sk sk--bar" />
        <span class="sk sk--card" />
        <span class="sk sk--card" />
        <span class="sk sk--row" />
        <span class="sk sk--row" />
      </div>
    ) : (
      <div class="print__app">
        <span class="print__side">
          <span class="sk sk--dot" />
          <span class="sk sk--line" />
          <span class="sk sk--line" />
          <span class="sk sk--line" />
        </span>
        <span class="print__main">
          <span class="sk sk--bar" />
          {variant === 'dashboard' ? (
            <span class="print__chart">
              {[40, 65, 50, 80, 60, 92, 70].map((h) => (
                <span class="print__col" style={`height:${h}%`} />
              ))}
            </span>
          ) : (
            <span class="print__table">
              {[1, 2, 3, 4, 5].map(() => (
                <span class="sk sk--row" />
              ))}
            </span>
          )}
        </span>
      </div>
    )
  }
</div>

<style>
  .print {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background:
      radial-gradient(120% 80% at 80% 0%, var(--color-accent-soft), transparent 60%),
      color-mix(in srgb, var(--color-line) 40%, var(--color-surface));
    display: grid;
    place-items: center;
  }

  .sk {
    display: block;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-muted) 22%, transparent);
  }

  .sk--bar {
    height: 10%;
    min-height: 10px;
    width: 55%;
  }

  .sk--line {
    height: 6px;
    width: 80%;
  }

  .sk--dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.8;
  }

  .sk--row {
    height: 12%;
    min-height: 10px;
    width: 100%;
  }

  .sk--card {
    height: 22%;
    width: 100%;
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .print__app {
    display: grid;
    grid-template-columns: 22% 1fr;
    width: 86%;
    height: 78%;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.4);
  }

  .print__side {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 12px;
    border-right: 1px solid var(--color-line);
  }

  .print__main {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 12px;
    padding: 12px;
  }

  .print__chart {
    display: flex;
    align-items: flex-end;
    gap: 6%;
    padding-top: 8px;
  }

  .print__col {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: var(--color-accent);
    opacity: 0.75;
  }

  .print__table {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .print__phone {
    display: grid;
    align-content: start;
    gap: 8px;
    width: 30%;
    height: 86%;
    padding: 14px 10px;
    border-radius: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.4);
  }
</style>
