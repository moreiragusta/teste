---
/*
  Topo fixo com âncoras. Na parte final do hero, conforme a pessoa desce, a barra vai
  fechando das laterais para o centro; quando o próximo bloco chega ao topo, some.
  Subindo, reabre do mesmo jeito. Com movimento reduzido, some/aparece de uma vez.
*/
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { SHOW_CASES } from '../config/site';

const links = [
  { href: '#solucoes', label: 'Soluções' },
  ...(SHOW_CASES ? [{ href: '#casos', label: 'Casos' }] : []),
  { href: '#processo', label: 'Processo' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__home" href={import.meta.env.BASE_URL} aria-label="Nukki Tech, página inicial"><Logo /></a>

    <nav class="nav" aria-label="Seções">
      <ul class="nav__list" role="list">
        {
          links.map((link) => (
            <li>
              <a class="nav__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <WhatsAppButton size="sm" />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  // Parte final do hero (em fração da altura da tela) durante a qual a barra vai fechando.
  const CLOSE_RANGE = 0.6;

  if (header && hero) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;

    // 0 = aberta; 1 = fechada (quando o próximo bloco chega embaixo da barra).
    const update = () => {
      queued = false;
      const range = window.innerHeight * CLOSE_RANGE;
      const end = header.offsetHeight;
      const bottom = hero.getBoundingClientRect().bottom;
      let progress = Math.min(1, Math.max(0, (end + range - bottom) / range));
      if (reduce.matches) progress = progress >= 1 ? 1 : 0;
      header.style.setProperty('--close', progress.toFixed(4));
      header.classList.toggle('is-closed', progress >= 1);
    };

    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--color-line);
    /* Fecha das laterais para o centro conforme a rolagem (--close vai de 0 a 1 no script). */
    --close: 0;
    clip-path: inset(0 calc(var(--close) * 50%) 0 calc(var(--close) * 50%));
  }

  /* Totalmente fechada: some (e sai da navegação por teclado). */
  .header.is-closed {
    visibility: hidden;
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'home nav actions';
    align-items: center;
    gap: 12px 24px;
    min-height: var(--header-h);
  }

  .header__home {
    grid-area: home;
    text-decoration: none;
  }

  .header__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 10px;
    /* espaço para a borda de baixo do botão não encostar na linha do topo */
    padding-bottom: 3px;
  }

  .nav {
    grid-area: nav;
    justify-self: center;
  }

  .nav__list {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hover: colchetes entram dos lados e o texto fica violeta. */
  .nav__link {
    position: relative;
    display: inline-block;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav__link::before,
  .nav__link::after {
    position: absolute;
    top: 50%;
    color: var(--color-accent);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--motion-ease);
  }

  .nav__link::before {
    content: '[';
    left: 2px;
    transform: translate(-6px, -50%);
  }

  .nav__link::after {
    content: ']';
    right: 2px;
    transform: translate(6px, -50%);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--color-ink);
  }

  .nav__link:hover::before,
  .nav__link:hover::after,
  .nav__link:focus-visible::before,
  .nav__link:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Celular: só logo e botão de modo claro/escuro (sem âncoras e sem WhatsApp). */
  @media (max-width: 899px) {
    .header__inner {
      grid-template-columns: auto auto;
      grid-template-areas: 'home actions';
      justify-content: space-between;
    }

    .nav,
    .header__actions :global(.btn) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::before,
    .nav__link::after {
      transition: none;
    }
  }
</style>
