---
/*
  Topo fixo com âncoras.
  1. No começo do hero, conforme a pessoa desce, a barra encolhe até virar uma cápsula
     flutuante no centro (logo, âncoras e botões se aproximam do meio).
  2. Quando o próximo bloco chega ao topo, a cápsula sobe e some. Voltando ao hero, desce.
*/
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppIconButton from './WhatsAppIconButton.astro';
import { SHOW_CASES } from '../config/site';

const links = [
  { href: '#solucoes', label: 'Soluções' },
  ...(SHOW_CASES ? [{ href: '#casos', label: 'Casos' }] : []),
  { href: '#processo', label: 'Processo' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="header" data-header>
  <div class="header__shell" data-header-shell>
    <div class="header__inner" data-header-inner>
      <a class="header__home" href={import.meta.env.BASE_URL} aria-label="Nukki Tech, página inicial"><Logo /></a>

      <nav class="nav" aria-label="Seções">
        <ul class="nav__list" role="list">
          {
            links.map((link) => (
              <li>
                <a class="nav__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header__actions">
        <ThemeToggle />
        <WhatsAppIconButton />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const shell = document.querySelector<HTMLElement>('[data-header-shell]');
  const inner = document.querySelector<HTMLElement>('[data-header-inner]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  // Quanto rolar (fração da altura da tela) até a barra virar cápsula.
  const SHRINK_RANGE = 0.35;
  // Folga extra na cápsula além do espaço que logo + âncoras + botões precisam.
  const CAPSULE_SLACK = 24;

  if (header && shell && inner && hero) {
    let queued = false;

    // Largura mínima da cápsula = soma do que está visível dentro dela + espaços.
    const measure = () => {
      const kids = [...inner.children].filter((el) => (el as HTMLElement).offsetWidth > 0) as HTMLElement[];
      const style = getComputedStyle(inner);
      const gaps = parseFloat(style.columnGap) * (kids.length - 1);
      const pad = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      const content = kids.reduce((sum, el) => sum + el.offsetWidth, 0);
      shell.style.setProperty('--min', `${Math.ceil(content + gaps + pad + CAPSULE_SLACK)}px`);
    };

    const update = () => {
      queued = false;
      // 1. Encolher: 0 no topo, 1 depois de SHRINK_RANGE da tela.
      const shrink = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * SHRINK_RANGE)));
      header.style.setProperty('--p', shrink.toFixed(4));
      // 2. Sumir para cima quando o fim do hero passa por baixo da cápsula.
      // (posição sem o deslocamento da animação de sumir, para não ficar piscando)
      const barBottom = shrink * 12 + shell.offsetHeight;
      const gone = hero.getBoundingClientRect().bottom <= barBottom;
      header.classList.toggle('is-hidden', gone);
    };

    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      onScroll();
    });
    document.fonts?.ready.then(measure);
    measure();
    update();
  }
</script>

<style>
  /* Camada fixa e transparente; quem tem cara de barra é o .header__shell. */
  .header {
    --p: 0; /* 0 = barra cheia, 1 = cápsula (definido no script) */
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-top: calc(var(--p) * 12px);
    pointer-events: none;
    transition:
      transform 0.5s var(--motion-ease),
      visibility 0s linear 0s;
  }

  /* Depois do hero: sobe e some (e sai da navegação por teclado). */
  .header.is-hidden {
    transform: translateY(calc(-100% - 16px));
    visibility: hidden;
    transition:
      transform 0.5s cubic-bezier(0.55, 0, 0.45, 1),
      visibility 0s linear 0.5s;
  }

  .header__shell {
    --min: 320px; /* largura da cápsula (medida no script) */
    pointer-events: auto;
    width: calc(100% - (100% - var(--min)) * var(--p));
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-line-strong) calc(var(--p) * 100%), transparent);
    border-bottom-color: var(--color-line);
    border-radius: calc(var(--p) * 32px);
    box-shadow: 0 16px 40px -20px rgb(0 0 0 / calc(var(--p) * 0.35));
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'home nav actions';
    align-items: center;
    gap: 12px 24px;
    max-width: var(--container);
    min-height: calc(var(--header-h) - var(--p) * 12px);
    margin-inline: auto;
    padding-inline: calc(var(--gutter) - var(--p) * (var(--gutter) - 14px));
  }

  .header__home {
    grid-area: home;
    /* flex: o logo fica centrado na altura da barra (sem a sobra da linha de texto embaixo) */
    display: flex;
    align-items: center;
    align-self: center;
    text-decoration: none;
  }

  .header__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 10px;
    /* espaço para a borda de baixo do botão não encostar na linha */
    padding-bottom: 3px;
  }

  .nav {
    grid-area: nav;
    justify-self: center;
  }

  .nav__list {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hover: colchetes entram dos lados e o texto fica violeta. */
  .nav__link {
    position: relative;
    display: inline-block;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .nav__link::before,
  .nav__link::after {
    position: absolute;
    top: 50%;
    color: var(--color-accent);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--motion-ease);
  }

  .nav__link::before {
    content: '[';
    left: 2px;
    transform: translate(-6px, -50%);
  }

  .nav__link::after {
    content: ']';
    right: 2px;
    transform: translate(6px, -50%);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--color-ink);
  }

  .nav__link:hover::before,
  .nav__link:hover::after,
  .nav__link:focus-visible::before,
  .nav__link:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Celular: só logo e botão de modo claro/escuro (sem âncoras e sem WhatsApp). */
  @media (max-width: 899px) {
    .header__inner {
      grid-template-columns: auto auto;
      grid-template-areas: 'home actions';
      justify-content: space-between;
    }

    .nav,
    .header__actions :global(.wa-icon) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header.is-hidden,
    .nav__link::before,
    .nav__link::after {
      transition: none;
    }
  }
</style>
