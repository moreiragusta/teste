---
import Nukki from './mascot/Nukki.astro';
import WhatsAppButton from './WhatsAppButton.astro';

const SLOGAN = 'Soluções além do código.';
// Palavras que alternam no subtítulo. A primeira aparece sem JS.
const WORDS = ['automações', 'sistemas', 'apps', 'relatórios', 'sites'];
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-hero>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true" data-depth="0.4"></div>

  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow" data-reveal>Nukki Tech · Atendimento em todo o Brasil</p>

      <h1 id="hero-title" class="hero__title">
        <span class="visually-hidden">{SLOGAN}</span>
        <span aria-hidden="true" data-scramble>{SLOGAN}</span>
      </h1>

      <p class="hero__sub" data-reveal>
        <span class="visually-hidden">A gente cria {WORDS.slice(0, -1).join(', ')} e {WORDS.at(-1)} sob medida.</span>
        <span aria-hidden="true">
          A gente cria <span class="hero__word" data-words={JSON.stringify(WORDS)}>{WORDS[0]}</span><span class="hero__caret"></span>
        </span>
      </p>

      <div class="hero__cta" data-reveal>
        <WhatsAppButton size="md" />
        <p class="hero__micro">Resposta em até 1 dia útil.</p>
      </div>
    </div>

    <div class="hero__mascot" data-depth="-0.15">
      <Nukki />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: calc(var(--header-h) + clamp(40px, 8vw, 96px));
    padding-bottom: var(--section-space);
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    top: 10%;
    left: 50%;
    width: min(900px, 120vw);
    aspect-ratio: 2;
    translate: -50% 0;
    background: radial-gradient(closest-side, var(--color-glow), transparent);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    gap: clamp(48px, 8vw, 64px);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: 24px;
  }

  .hero__title {
    font-size: clamp(2.75rem, 10vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 12ch;
  }

  .hero__sub {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: clamp(1.0625rem, 2.6vw, 1.375rem);
    color: var(--color-muted);
  }

  .hero__word {
    color: var(--color-accent);
  }

  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--color-accent);
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  .hero__cta {
    margin-top: 44px;
  }

  .hero__micro {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .hero__mascot {
    justify-self: center;
    width: min(70vw, 300px);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.3fr 1fr;
      min-height: calc(100svh - var(--header-h) - var(--section-space));
    }

    .hero__mascot {
      width: 100%;
      max-width: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__caret {
      animation: none;
    }
  }
</style>
