---
// Alterna modo claro/escuro. A escolha fica salva no navegador; sem escolha, segue o sistema.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar modo claro e escuro">
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;

  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: var(--toon-border) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      translate 0.16s var(--motion-ease),
      box-shadow 0.16s var(--motion-ease),
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    translate: 2px 2px;
    box-shadow: 1px 1px 0 0 var(--color-ink);
    background: var(--color-accent-soft);
  }

  svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.4s var(--motion-ease);
  }

  .theme-toggle:hover svg {
    transform: rotate(-20deg);
  }

  /* Mostra o ícone do modo para o qual o botão leva. */
  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>
