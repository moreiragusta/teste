---
/*
  Seção "Na prática": carrossel de trabalhos com destaque.
  - O trabalho em destaque fica em tamanho cheio; os outros menores e apagados.
  - Setas, arrastar (mouse ou dedo), ←/→ e barra de progresso.
  - Clicar num trabalho abre o painel lateral com a ficha completa e mais prints.
  Liga/desliga em src/config/site.ts (SHOW_CASES).

  Regras: nunca inventar depoimentos, números ou logos. Casos sem nome de cliente.
  Prints sempre com dados fictícios.
*/
import CasePrint from './CasePrint.astro';

// TODO [PLACEHOLDER]: todos os trabalhos abaixo são genéricos. Trocar por trabalhos reais.
const cases = [
  {
    sector: 'Escritório de serviços',
    title: '[PLACEHOLDER] Leitura automática de documentos',
    before: 'Documentos analisados à mão, página por página.',
    after: 'Informações extraídas e organizadas automaticamente.',
    result: '[X horas → Y min]',
    tags: ['Automação', 'Extração de dados'],
    print: 'table',
  },
  {
    sector: 'Comércio',
    title: '[PLACEHOLDER] Painel de vendas e estoque',
    before: 'Vendas e estoque em planilhas separadas.',
    after: 'Tudo num painel só, atualizado sozinho.',
    result: '[resultado]',
    tags: ['Relatórios', 'UI/UX'],
    print: 'dashboard',
  },
  {
    sector: 'Empresa de serviços',
    title: '[PLACEHOLDER] App de pedidos',
    before: 'Pedidos chegando soltos pelo WhatsApp.',
    after: 'Pedidos organizados num sistema simples.',
    result: '[resultado]',
    tags: ['Sistema', 'Mobile first'],
    print: 'phone',
  },
] as const;

const pad = (n: number) => String(n).padStart(2, '0');
const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowLeft = 'M19 12H5M11 6l-6 6 6 6';
---

<section class="section cases" id="casos" aria-labelledby="cases-title" data-cases>
  <div class="container cases__head">
    <h2 id="cases-title" class="section-title" data-reveal>Na prática</h2>
    <div class="cases__nav" data-reveal>
      <button class="btn btn--icon" type="button" data-cases-prev aria-label="Trabalho anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrowLeft} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button class="btn btn--icon" type="button" data-cases-next aria-label="Próximo trabalho">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <ul class="cases__track" role="list" data-cases-track data-reveal aria-label="Trabalhos">
    {
      cases.map((item, i) => (
        <li class:list={['case', i === 0 && 'is-active']} data-case>
          <button class="case__open" type="button" data-case-open={i} aria-haspopup="dialog">
            <span class="case__media">
              <CasePrint variant={item.print} label={item.title} />
              <span class="case__more" aria-hidden="true">
                Ver detalhes
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
            <span class="case__info">
              <span class="case__sector">{item.sector}</span>
              <span class="case__title">{item.title}</span>
              <span class="case__result">
                <span class="visually-hidden">Resultado: </span>
                {item.result}
              </span>
            </span>
          </button>
          <ul class="case__tags" role="list" aria-label="Etiquetas">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <div class="container cases__foot" data-reveal>
    <div class="cases__progress" aria-hidden="true"><span data-cases-bar></span></div>
    <span class="cases__count" aria-live="polite" data-cases-count>{pad(1)} / {pad(cases.length)}</span>
  </div>

  <!-- Painel de detalhes (um <article> por trabalho; o script mostra o escolhido). -->
  <dialog class="panel" data-case-panel aria-label="Detalhes do trabalho">
    <button class="panel__close" type="button" data-case-close aria-label="Fechar detalhes">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    {
      cases.map((item, i) => (
        <article class="panel__case" data-case-detail={i} hidden>
          <p class="panel__sector">
            {item.sector} · {pad(i + 1)}/{pad(cases.length)}
          </p>
          <h3 class="panel__title">{item.title}</h3>
          <ul class="case__tags" role="list" aria-label="Etiquetas">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <dl class="panel__facts">
            <div>
              <dt>Antes</dt>
              <dd>{item.before}</dd>
            </div>
            <div>
              <dt>Depois</dt>
              <dd>{item.after}</dd>
            </div>
            <div class="panel__result">
              <dt>Resultado</dt>
              <dd>{item.result}</dd>
            </div>
          </dl>
          {/* TODO [PLACEHOLDER]: mais prints do trabalho (dados fictícios). */}
          <div class="panel__gallery">
            <CasePrint variant={item.print} label={`${item.title}, tela 1`} />
            <CasePrint variant={item.print === 'phone' ? 'phone' : 'dashboard'} label={`${item.title}, tela 2`} />
          </div>
        </article>
      ))
    }
  </dialog>
</section>

<script>
  import { lockScroll } from '../scripts/scroll-lock';

  const root = document.querySelector<HTMLElement>('[data-cases]');
  const track = root?.querySelector<HTMLElement>('[data-cases-track]');
  const panel = root?.querySelector<HTMLDialogElement>('[data-case-panel]');

  if (root && track && panel) {
    const items = [...track.querySelectorAll<HTMLElement>('[data-case]')];
    const bar = root.querySelector<HTMLElement>('[data-cases-bar]');
    const count = root.querySelector<HTMLElement>('[data-cases-count]');
    const prev = root.querySelector<HTMLButtonElement>('[data-cases-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-cases-next]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pad = (n: number) => String(n).padStart(2, '0');
    let active = 0;

    // Distância entre o início de um trabalho e o próximo.
    const step = () => (items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth);

    const setActive = (index: number) => {
      active = Math.max(0, Math.min(items.length - 1, index));
      items.forEach((item, i) => item.classList.toggle('is-active', i === active));
      if (bar) bar.style.transform = `scaleX(${(active + 1) / items.length})`;
      if (count) count.textContent = `${pad(active + 1)} / ${pad(items.length)}`;
      prev?.setAttribute('aria-disabled', String(active === 0));
      next?.setAttribute('aria-disabled', String(active === items.length - 1));
    };

    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(items.length - 1, index));
      track.scrollTo({ left: target * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
      setActive(target);
    };

    // Destaque acompanha a rolagem horizontal (dedo, trackpad, arrastar).
    let queued = false;
    track.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          setActive(Math.round(track.scrollLeft / step()));
        });
      },
      { passive: true },
    );

    prev?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') goTo(active + 1);
      if (event.key === 'ArrowLeft') goTo(active - 1);
    });

    // Arrastar com o mouse (no toque, a rolagem nativa já resolve).
    let dragX: number | null = null;
    let startLeft = 0;
    let moved = false;
    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      dragX = event.clientX;
      startLeft = track.scrollLeft;
      moved = false;
    });
    window.addEventListener('pointermove', (event) => {
      if (dragX === null) return;
      const dx = event.clientX - dragX;
      if (Math.abs(dx) > 5) {
        moved = true;
        track.classList.add('is-dragging');
      }
      track.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      if (dragX === null) return;
      dragX = null;
      track.classList.remove('is-dragging');
      if (moved) goTo(Math.round(track.scrollLeft / step()));
    });

    // Painel de detalhes
    const details = [...panel.querySelectorAll<HTMLElement>('[data-case-detail]')];

    const open = (index: number) => {
      details.forEach((d, i) => (d.hidden = i !== index));
      panel.showModal();
      panel.scrollTop = 0;
      lockScroll(true);
    };

    const close = () => {
      if (!panel.open) return;
      panel.classList.add('is-closing');
      const done = () => {
        panel.classList.remove('is-closing');
        panel.close();
      };
      if (reduce.matches) done();
      else setTimeout(done, 280);
    };

    track.querySelectorAll<HTMLButtonElement>('[data-case-open]').forEach((button) => {
      button.addEventListener('click', (event) => {
        // Um arrasto não conta como clique.
        if (moved) {
          event.preventDefault();
          moved = false;
          return;
        }
        open(Number(button.dataset.caseOpen));
      });
    });

    panel.querySelector('[data-case-close]')?.addEventListener('click', close);
    // Clique fora do painel (no fundo escurecido) fecha.
    panel.addEventListener('click', (event) => {
      if (event.target === panel) close();
    });
    panel.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    panel.addEventListener('close', () => lockScroll(false));

    setActive(0);
  }
</script>

<style>
  /* ---------- Cabeçalho ---------- */
  .cases__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .cases__head .section-title {
    margin: 0;
  }

  .cases__nav {
    display: flex;
    gap: 12px;
    padding-bottom: 6px;
  }

  .cases__nav [aria-disabled='true'] {
    opacity: 0.35;
    pointer-events: none;
  }

  /* ---------- Trilho (vai até a borda da tela, alinhado ao conteúdo à esquerda) ---------- */
  .cases__track {
    --edge: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    --card: clamp(280px, 82vw, 520px);
    display: flex;
    gap: clamp(16px, 2.5vw, 28px);
    margin: 0;
    padding: 8px var(--edge) 12px;
    /* espaço à direita para o último trabalho também conseguir ir para o destaque */
    padding-inline-end: max(var(--edge), calc(100vw - var(--card) - var(--edge)));
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    cursor: grab;
  }

  .cases__track::-webkit-scrollbar {
    display: none;
  }

  .cases__track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  /* ---------- Trabalho ---------- */
  .case {
    flex: 0 0 var(--card);
    scroll-snap-align: start;
    display: grid;
    gap: 16px;
    align-content: start;
    transform-origin: left top;
    transform: scale(0.94);
    opacity: 0.5;
    transition:
      transform var(--motion-duration) var(--motion-ease),
      opacity var(--motion-duration) var(--motion-ease);
  }

  .case.is-active {
    transform: none;
    opacity: 1;
  }

  @media (hover: hover) {
    .case:not(.is-active):hover {
      opacity: 0.8;
    }
  }

  .case__open {
    display: grid;
    gap: 18px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: inherit;
  }

  .case__media {
    position: relative;
    display: block;
    border-radius: var(--radius);
    padding: 1px;
    background: var(--color-line-strong);
    transition: background-color 0.3s ease;
  }

  .case.is-active .case__media {
    background: var(--color-accent);
  }

  .case__media :global(.print) {
    border-radius: calc(var(--radius) - 1px);
  }

  /* "Ver detalhes" sobe por cima do print no hover/foco. */
  .case__more {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--motion-ease);
  }

  .case__more svg {
    width: 14px;
    height: 14px;
  }

  .case__open:hover .case__more,
  .case__open:focus-visible .case__more {
    opacity: 1;
    transform: none;
  }

  /* No toque não há hover: o "Ver detalhes" fica sempre visível no destaque. */
  @media (hover: none) {
    .case.is-active .case__more {
      opacity: 1;
      transform: none;
    }
  }

  .case__info {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'sector result'
      'title  result';
    align-items: start;
    gap: 6px 20px;
  }

  /* Celular: resultado embaixo do título, para o título não ficar espremido. */
  @media (max-width: 640px) {
    .case__info {
      grid-template-columns: 1fr;
      grid-template-areas:
        'sector'
        'title'
        'result';
    }

    .case__result {
      align-self: start;
      margin-top: 4px;
    }
  }

  .case__sector {
    grid-area: sector;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .case__title {
    grid-area: title;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .case__result {
    grid-area: result;
    align-self: center;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    white-space: nowrap;
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case__tags li {
    padding: 4px 10px;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* ---------- Progresso ---------- */
  .cases__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .cases__progress {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--color-line);
    overflow: hidden;
  }

  .cases__progress span {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0.33);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .cases__count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* ---------- Painel de detalhes ---------- */
  .panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(560px, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(28px, 5vw, 48px);
    padding-top: 72px;
    border: 0;
    border-left: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(0);
    transition:
      transform 0.45s var(--motion-ease),
      display 0.45s allow-discrete,
      overlay 0.45s allow-discrete;
  }

  @starting-style {
    .panel[open] {
      transform: translateX(100%);
    }
  }

  .panel.is-closing {
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.55, 0, 1, 0.45);
  }

  .panel::backdrop {
    background: rgb(5 7 12 / 0.55);
    backdrop-filter: blur(4px);
  }

  /* Celular: sobe de baixo, ocupando quase a tela toda. */
  @media (max-width: 640px) {
    .panel {
      inset: auto 0 0 0;
      width: 100vw;
      height: 92dvh;
      border-left: 0;
      border-top: 1px solid var(--color-line);
      border-radius: 20px 20px 0 0;
    }

    @starting-style {
      .panel[open] {
        transform: translateY(100%);
      }
    }

    .panel.is-closing {
      transform: translateY(100%);
    }
  }

  .panel__close {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      transform 0.3s var(--motion-ease);
  }

  .panel__close:hover {
    border-color: var(--color-ink);
    transform: rotate(90deg);
  }

  .panel__close svg {
    width: 18px;
    height: 18px;
  }

  .panel__case {
    display: grid;
    gap: 20px;
  }

  .panel__case[hidden] {
    display: none;
  }

  .panel__sector {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  .panel__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .panel__facts {
    display: grid;
    gap: 16px;
    margin: 8px 0;
  }

  .panel__facts dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .panel__facts dd {
    margin: 4px 0 0;
    font-size: 1.125rem;
  }

  .panel__result {
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
  }

  .panel__result dd {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .panel__gallery {
    display: grid;
    gap: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .case,
    .case__more,
    .cases__progress span,
    .panel,
    .panel.is-closing {
      transition: none;
    }
  }
</style>
