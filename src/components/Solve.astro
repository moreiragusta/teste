---
/*
  Pilha de cartões: um em destaque e os outros em cascata atrás.
  A cada STACK_INTERVAL (src/scripts/motion/constants.ts) o da frente vai para o fim da fila.
  Setas dos lados (no celular, embaixo) trocam manualmente; arrastar para o lado também.
  Sem JS ou com movimento reduzido, os cartões aparecem em grade, todos visíveis.

  Cada cartão é uma "janela de sistema": barra com três bolinhas e endereço nukki://…,
  e o antes/depois escrito como alteração de código (linha − riscada, linha + em destaque).
*/
const cards = [
  {
    area: 'Automação',
    slug: 'automacao',
    before: 'PDFs digitados na planilha, um por um.',
    after: 'Dados extraídos e organizados sozinhos.',
  },
  {
    area: 'Relatórios',
    slug: 'relatorios',
    before: 'Uma tarde inteira montando relatório.',
    after: 'Relatório pronto em minutos.',
  },
  {
    area: 'Sistemas e apps',
    slug: 'sistemas',
    before: 'Controle em planilha, caderno e WhatsApp.',
    after: 'Um sistema feito pro seu jeito de trabalhar.',
  },
  {
    area: 'Sites',
    slug: 'sites',
    before: 'O cliente procura e não encontra você.',
    after: 'Um site rápido que leva direto pro seu WhatsApp.',
  },
];

const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowLeft = 'M19 12H5M11 6l-6 6 6 6';
---

<section class="section" id="solucoes" aria-labelledby="solve-title">
  <div class="container">
    <div class="section-head">
      <h2 id="solve-title" class="section-title" data-reveal>O que nós resolvemos</h2>
    </div>

    <div class="stack" data-stack role="region" aria-roledescription="carrossel" aria-labelledby="solve-title" data-reveal>
      <button class="btn btn--icon stack__nav stack__prev" type="button" data-stack-prev aria-label="Cartão anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrowLeft} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <ul class="stack__cards" role="list" data-stack-cards aria-live="off">
        {
          cards.map((card, i) => (
            <li class="card" data-card aria-roledescription="cartão" aria-label={`${i + 1} de ${cards.length}: ${card.area}`}>
              <span class="card__corners" aria-hidden="true" />
              <div class="card__bar" aria-hidden="true">
                <span class="card__dots">
                  <i />
                  <i />
                  <i />
                </span>
                <span class="card__path">nukki://{card.slug}</span>
                <span class="card__count">
                  {i + 1}/{cards.length}
                </span>
              </div>
              <div class="card__body">
                <h3 class="card__area">{card.area}</h3>
                <div class="diff">
                  <p class="diff__line diff__line--del">
                    <span class="diff__num" aria-hidden="true">1</span>
                    <span class="diff__sign" aria-hidden="true">−</span>
                    <span class="visually-hidden">Antes: </span>
                    <s>{card.before}</s>
                  </p>
                  <p class="diff__line diff__line--add">
                    <span class="diff__num" aria-hidden="true">2</span>
                    <span class="diff__sign" aria-hidden="true">+</span>
                    <span class="visually-hidden">Depois: {card.after}</span>
                    <span class="diff__text" aria-hidden="true" data-after data-from={card.before}>{card.after}</span>
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <button class="btn btn--icon stack__nav stack__next" type="button" data-stack-next aria-label="Próximo cartão">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="stack__bar">
        <button class="stack__pause" type="button" data-stack-pause aria-pressed="false" aria-label="Pausar troca automática">
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7Z"></path></svg>
        </button>
        <ol class="stack__dots" role="list" aria-hidden="true">
          {cards.map(() => <li class="stack__dot" data-stack-dot><span /></li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Sem JS / movimento reduzido: grade simples ---------- */
  .stack__cards {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .stack__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stack__nav,
  .stack__bar {
    display: none;
  }

  /* ---------- Cartão: janela de sistema ---------- */
  .card {
    position: relative;
    display: grid;
    align-content: start;
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .card__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-line) 35%, var(--color-surface));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .card__dots {
    display: flex;
    gap: 6px;
  }

  .card__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
  }

  .card__dots i:first-child {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .card__path {
    justify-self: center;
    padding: 3px 12px;
    border-radius: 6px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    white-space: nowrap;
  }

  .card__body {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 4vw, 36px);
  }

  .card__area {
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  /* Antes/depois como alteração de código: número da linha, sinal e conteúdo. */
  .diff {
    display: grid;
    gap: 6px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .diff__line {
    display: grid;
    grid-template-columns: 2ch 1.5ch 1fr;
    align-items: baseline;
    gap: 10px;
    padding: 12px 16px 12px 12px;
    border-left: 2px solid transparent;
  }

  .diff__num,
  .diff__sign {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-align: right;
  }

  .diff__line--del {
    background: color-mix(in srgb, var(--color-line) 45%, transparent);
    border-left-color: var(--color-line-strong);
    color: var(--color-muted);
  }

  .diff__line--del s {
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-line-strong);
  }

  .diff__line--add {
    background: var(--color-accent-soft);
    border-left-color: var(--color-accent);
  }

  .diff__line--add .diff__sign {
    color: var(--color-accent);
    font-weight: 700;
  }

  .diff__text {
    font-size: clamp(1.375rem, 3.4vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  /* Cantos de "mira" que se fecham sobre o cartão da frente no hover. */
  .card__corners {
    position: absolute;
    inset: 12px;
    pointer-events: none;
    --c: var(--color-accent);
    --l: 14px;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) top left / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) top right / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) top right / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) bottom left / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) bottom right / 1.5px var(--l);
    background-repeat: no-repeat;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--motion-ease);
  }

  @media (hover: hover) {
    .card:hover .card__corners {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ---------- Modo pilha (ligado pelo JS com a classe .is-stack) ---------- */
  .stack.is-stack {
    display: grid;
    grid-template-columns: auto minmax(0, 640px) auto;
    grid-template-areas:
      'prev cards next'
      '.    bar   .';
    justify-content: center;
    align-items: center;
    column-gap: clamp(16px, 4vw, 48px);
    row-gap: 28px;
  }

  .is-stack .stack__cards {
    grid-area: cards;
    display: grid;
    grid-template-columns: 1fr;
    /* espaço para as barras dos cartões de trás aparecerem por cima */
    padding-top: 48px;
    touch-action: pan-y;
    user-select: none;
  }

  .is-stack .card {
    grid-area: 1 / 1;
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* Conteúdo dos cartões de trás fica apagado; só a borda aparece na cascata. */
  .is-stack .card:not(.is-front) .card__body {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .is-stack .card.is-front .card__body {
    transition: opacity 0.4s ease 0.15s;
  }

  .is-stack .stack__nav {
    display: inline-flex;
  }

  .is-stack .stack__prev {
    grid-area: prev;
  }

  .is-stack .stack__next {
    grid-area: next;
  }

  .btn.stack__prev:hover svg {
    transform: translateX(-3px);
  }

  .is-stack .stack__bar {
    grid-area: bar;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  /* Celular: setas embaixo, uma de cada lado da barra de progresso. */
  @media (max-width: 759px) {
    .stack.is-stack {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'cards cards cards'
        'prev  bar   next';
      column-gap: 12px;
    }
  }

  .stack__dots {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Bolinha vira barra no cartão atual e se preenche até a próxima troca. */
  .stack__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-line-strong);
    overflow: hidden;
    transition: width 0.4s var(--motion-ease);
  }

  .stack__dot.is-active {
    width: 40px;
  }

  .stack__dot span {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .stack__pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .stack__pause:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .stack__pause svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-play,
  .stack__pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .stack__pause[aria-pressed='true'] .icon-play {
    display: block;
  }
</style>
