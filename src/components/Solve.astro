---
/*
  Pilha de cartões: um em destaque e os outros em cascata atrás.
  A cada STACK_INTERVAL (src/scripts/motion/constants.ts) o da frente vai para o fim da fila.
  Setas dos lados (no celular, embaixo) trocam manualmente; arrastar para o lado também.
  Sem JS ou com movimento reduzido, os cartões aparecem em grade, todos visíveis.
*/
const cards = [
  {
    area: 'Automação',
    before: 'PDFs digitados na planilha, um por um.',
    after: 'Dados extraídos e organizados sozinhos.',
  },
  {
    area: 'Relatórios',
    before: 'Uma tarde inteira montando relatório.',
    after: 'Relatório pronto em minutos.',
  },
  {
    area: 'Sistemas e apps',
    before: 'Controle em planilha, caderno e WhatsApp.',
    after: 'Um sistema feito pro seu jeito de trabalhar.',
  },
  {
    area: 'Sites',
    before: 'O cliente procura e não encontra você.',
    after: 'Um site rápido que leva direto pro seu WhatsApp.',
  },
];

const arrow = 'M5 12h14M13 6l6 6-6 6';
const arrowLeft = 'M19 12H5M11 6l-6 6 6 6';
---

<section class="section" id="solucoes" aria-labelledby="solve-title">
  <div class="container">
    <div class="section-head">
      <h2 id="solve-title" class="section-title" data-reveal>Soluções</h2>
      <p class="section-lead" data-reveal>
        Encontramos o que toma tempo da sua equipe e transformamos em algo que funciona sozinho. Veja o antes e o
        depois de cada tipo de trabalho.
      </p>
    </div>

    <div class="stack" data-stack role="region" aria-roledescription="carrossel" aria-labelledby="solve-title" data-reveal>
      <button class="btn btn--icon stack__nav stack__prev" type="button" data-stack-prev aria-label="Cartão anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrowLeft} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <ul class="stack__cards" role="list" data-stack-cards aria-live="off">
        {
          cards.map((card, i) => (
            <li class="card" data-card aria-roledescription="cartão" aria-label={`${i + 1} de ${cards.length}: ${card.area}`}>
              <span class="card__corners" aria-hidden="true" />
              <div class="card__top">
                <h3 class="card__area">{card.area}</h3>
                <span class="card__count" aria-hidden="true">
                  {i + 1}/{cards.length}
                </span>
              </div>
              <p class="card__before">
                <span class="visually-hidden">Antes: </span>
                <s>{card.before}</s>
              </p>
              <p class="card__after">
                <span class="visually-hidden">Depois: {card.after}</span>
                <span aria-hidden="true" data-after data-from={card.before}>{card.after}</span>
              </p>
            </li>
          ))
        }
      </ul>

      <button class="btn btn--icon stack__nav stack__next" type="button" data-stack-next aria-label="Próximo cartão">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d={arrow} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <button class="stack__pause" type="button" data-stack-pause aria-pressed="false" aria-label="Pausar troca automática">
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"></path></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7Z"></path></svg>
      </button>

      <!-- Nomes das frentes: mostram as quatro de uma vez e levam direto a cada uma. -->
      <div class="stack__bar" role="group" aria-label="Escolher frente">
        {
          cards.map((card, i) => (
            <button class="stack__tab" type="button" data-stack-tab={i}>
              <span>{card.area}</span>
              <span class="stack__tab-track" aria-hidden="true">
                <span class="stack__tab-fill" />
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Sem JS / movimento reduzido: grade simples ---------- */
  .stack__cards {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .stack__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stack__nav,
  .stack__bar,
  .stack__pause {
    display: none;
  }

  /* ---------- Cartão ---------- */
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(26px, 4vw, 44px);
    background: var(--color-surface);
    /* Estilo "cartoon": borda grossa e sombra dura, mesmo DNA do botão. */
    border: var(--toon-border) solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    /* top/left (e não transform/translate) porque o GSAP controla o transform da pilha. */
    top: 0;
    left: 0;
    transition:
      top 0.16s var(--motion-ease),
      left 0.16s var(--motion-ease),
      box-shadow 0.16s var(--motion-ease);
  }

  /* Cartão da frente: sombra violeta. */
  .is-stack .card.is-front {
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-accent);
  }

  /* Cartões de trás na cascata: só a borda, sem sombra (menos ruído). */
  .is-stack .card:not(.is-front) {
    box-shadow: none;
  }

  /* Hover: o cartão "afunda" e a sombra diminui, como o botão. */
  @media (hover: hover) {
    .stack:not(.is-stack) .card:hover,
    .is-stack .card.is-front:hover {
      top: calc(var(--toon-depth) * 0.6);
      left: calc(var(--toon-depth) * 0.6);
      box-shadow: calc(var(--toon-depth) * 0.4) calc(var(--toon-depth) * 0.4) 0 0 var(--color-accent);
    }

    .stack:not(.is-stack) .card:hover {
      box-shadow: calc(var(--toon-depth) * 0.4) calc(var(--toon-depth) * 0.4) 0 0 var(--color-ink);
    }
  }

  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .card__area {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .card__count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .card__before {
    color: var(--color-muted);
  }

  .card__before s {
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-line-strong);
  }

  .card__after {
    font-size: clamp(1.625rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  /* Cantos de "mira" que se fecham sobre o cartão da frente no hover. */
  .card__corners {
    position: absolute;
    inset: 12px;
    pointer-events: none;
    --c: var(--color-accent);
    --l: 14px;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) top left / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) top right / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) top right / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) bottom left / 1.5px var(--l),
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 1.5px,
      linear-gradient(var(--c), var(--c)) bottom right / 1.5px var(--l);
    background-repeat: no-repeat;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--motion-ease);
  }

  @media (hover: hover) {
    .card:hover .card__corners {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ---------- Modo pilha (ligado pelo JS com a classe .is-stack) ---------- */
  .stack.is-stack {
    display: grid;
    grid-template-columns: auto minmax(0, 640px) auto;
    grid-template-areas:
      'prev cards next'
      '.    bar   pause';
    justify-content: center;
    align-items: center;
    column-gap: clamp(16px, 4vw, 48px);
    row-gap: 28px;
  }

  .is-stack .stack__cards {
    grid-area: cards;
    display: grid;
    grid-template-columns: 1fr;
    /* espaço para os cartões de trás aparecerem por cima */
    padding-top: 48px;
    touch-action: pan-y;
    user-select: none;
  }

  .is-stack .card {
    grid-area: 1 / 1;
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* Conteúdo dos cartões de trás fica apagado; só a borda aparece na cascata. */
  .is-stack .card:not(.is-front) > :not(.card__corners) {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .is-stack .card.is-front > * {
    transition: opacity 0.4s ease 0.15s;
  }

  .is-stack .stack__nav {
    display: inline-flex;
  }

  .is-stack .stack__prev {
    grid-area: prev;
  }

  .is-stack .stack__next {
    grid-area: next;
  }

  .btn.stack__prev:hover svg {
    transform: translateX(-3px);
  }

  .is-stack .stack__bar {
    grid-area: bar;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
  }

  .is-stack .stack__pause {
    grid-area: pause;
    display: grid;
  }

  /* Celular: nomes numa linha só embaixo dos cartões; setas e pausa embaixo deles. */
  @media (max-width: 759px) {
    .stack.is-stack {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'cards cards cards'
        'bar   bar   bar'
        'prev  pause next';
      column-gap: 12px;
      row-gap: 20px;
    }

    .is-stack .stack__pause {
      justify-self: center;
    }

    .is-stack .stack__bar {
      justify-content: space-between;
      gap: 4px 8px;
    }

    .is-stack .stack__tab {
      font-size: 0.75rem;
    }
  }

  /* Nome da frente; o ativo fica na cor do texto e a barra embaixo se enche até a próxima troca. */
  .stack__tab {
    display: grid;
    gap: 6px;
    min-height: 44px;
    align-content: center;
    padding: 6px 2px;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .stack__tab:hover,
  .stack__tab.is-active {
    color: var(--color-ink);
  }

  .stack__tab-track {
    position: relative;
    height: 2px;
    border-radius: 2px;
    background: var(--color-line);
    overflow: hidden;
  }

  .stack__tab-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .stack__pause {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--toon-border) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: var(--toon-depth) var(--toon-depth) 0 0 var(--color-ink);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      translate 0.16s var(--motion-ease),
      box-shadow 0.16s var(--motion-ease);
  }

  .stack__pause:hover {
    translate: 2px 2px;
    box-shadow: 1px 1px 0 0 var(--color-ink);
  }

  .stack__pause svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-play,
  .stack__pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .stack__pause[aria-pressed='true'] .icon-play {
    display: block;
  }
</style>
