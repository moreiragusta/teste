---
/*
  Botão "de apertar": fundo da superfície, borda na cor do texto, mais grossa embaixo.
  No hover ele abaixa e a borda de baixo diminui; no clique encosta de vez.
  As cores vêm dos tokens, então no modo escuro ele se inverte sozinho.
*/
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  size?: 'sm' | 'md' | 'lg';
}

const { href, size = 'md', class: className, ...rest } = Astro.props;
---

<a class:list={['btn', `btn--${size}`, className]} href={href} {...rest}>
  <slot />
</a>

<style>
  .btn {
    --depth: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius);
    box-shadow: 0 var(--depth) 0 0 var(--color-ink);
    transform: translateY(0);
    transition:
      transform 0.16s var(--motion-ease),
      box-shadow 0.16s var(--motion-ease),
      background-color 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .btn:hover {
    transform: translateY(calc(var(--depth) * 0.6));
    box-shadow: 0 calc(var(--depth) * 0.4) 0 0 var(--color-ink);
  }

  .btn:active {
    transform: translateY(var(--depth));
    box-shadow: 0 0 0 0 var(--color-ink);
  }

  /* Ícone opcional dentro do botão desliza um pouco no hover. */
  .btn :global(svg) {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    transition: transform 0.25s var(--motion-ease);
  }

  .btn:hover :global(svg) {
    transform: translateX(3px);
  }

  .btn--sm {
    --depth: 3px;
    font-size: 0.875rem;
    padding: 0.55em 1em;
    min-height: 42px;
    border-radius: var(--radius-sm);
  }

  .btn--md {
    font-size: 1.0625rem;
    padding: 0.85em 1.5em;
    min-height: 54px;
  }

  .btn--lg {
    --depth: 6px;
    font-size: clamp(1.125rem, 3vw, 1.3125rem);
    padding: 1em 2em;
    min-height: 64px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn :global(svg) {
      transition: none;
    }
  }
</style>
