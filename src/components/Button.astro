---
// Link com o estilo de botão "de apertar" (classe .btn em src/styles/global.css).
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  size?: 'sm' | 'md' | 'lg';
}

const { href, size = 'md', class: className, ...rest } = Astro.props;
---

<a class:list={['btn', `btn--${size}`, className]} href={href} {...rest}>
  <slot />
</a>
